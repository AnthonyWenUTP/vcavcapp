<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical" 
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        
	    <TextView
	        android:id="@+id/label_localidad"
	        android:textSize="@dimen/encabezado"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:paddingBottom="@dimen/activity_vertical_margin"
	        android:text="@string/house_search"
	        android:textStyle="bold" />
	    
        <TextView
	        android:id="@+id/label_header"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:drawableStart="@drawable/ic_menu_find_holo_light"
	        android:paddingBottom="@dimen/activity_vertical_margin"
	        android:paddingTop="@dimen/activity_vertical_margin"
	        android:text="@string/viewlist"
	        android:textStyle="bold"
	        style="?android:textAppearanceMedium" />
        <org.osmdroid.views.MapView android:id="@+id/map"
                android:layout_width="fill_parent" 
                android:layout_height="fill_parent" />
</LinearLayout>