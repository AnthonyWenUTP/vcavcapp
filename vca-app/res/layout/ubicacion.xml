<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".IngresarEncuestaActivity" >
    
    

    <TextView
        android:id="@+id/label_header"
        style="?android:textAppearanceLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_myplaces"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/ubicacion"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/label_encuesta"
        style="?android:textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/ident"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/label_latitud"
        style="?android:textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/latitud"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/label_longitud"
        style="?android:textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/longitud"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/label_exactitud"
        style="?android:textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/latitud"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/label_altitud"
        style="?android:textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/longitud"
        android:textStyle="bold" />
 
	
	



	<LinearLayout 
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="horizontal"
              android:padding="20dp"
              android:weightSum="2"
              style="?android:attr/buttonBarButtonStyle">

    
    <Button
        	android:text="@string/get_location"
        	android:textSize="22sp"
        	android:drawableStart="@drawable/ic_menu_mylocation"
        	android:id="@+id/open_button"
        	android:layout_weight="1"
        	android:layout_width="0dp"
		 	android:layout_height="wrap_content"
			android:layout_marginEnd="10dp"
			style="?android:attr/buttonBarButtonStyle"
        />
	
	 <Button
	        android:text="@string/ubc_add"
	        android:textSize="22sp"
	        android:drawableStart="@drawable/ic_menu_save"
	        android:id="@+id/save_button"
	        android:layout_weight="1"
			android:layout_width="0dp"
		 	android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			style="?android:attr/buttonBarButtonStyle"
        />

</LinearLayout>
        


</LinearLayout>