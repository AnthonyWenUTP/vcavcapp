<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".CensoActivity" >
    
    <TextView
        android:id="@+id/label_localidad"
        android:textSize="@dimen/encabezado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/house_search"
        android:textStyle="bold" />
    
   <TextView
        android:id="@+id/label_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_mapmode"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/viewmap"
        android:textStyle="bold"
	        style="?android:textAppearanceMedium"  />

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal">
    <EditText
        android:id="@+id/parametro"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:hint="@string/parametro"
        android:inputType="text"
        android:textSize="28sp"
        android:maxLines="1"
        android:singleLine="true"/>
    
    <ImageButton
        android:id="@+id/find_button"
        android:layout_width="wrap_content"
       	android:layout_height="match_parent"
        android:contentDescription="@string/ok"
        android:src="@drawable/ic_btn_search" />
    
    </LinearLayout>
    
    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1.0"
        
    />

    <Button
        android:id="@+id/add_button"
        android:layout_width="match_parent"
       	android:layout_height="wrap_content"
        android:contentDescription="@string/house_add"
        android:text="@string/house_add"
        android:textSize="22sp"
        android:drawableStart="@drawable/ic_new"/>

</LinearLayout>